{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "backend/server.js": {
      "includeFiles": "frontend/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "backend/server.js" },
    { "source": "/((?!api/).*)", "destination": "backend/server.js" }
  ]
}